# Required. Connection string for the MongoDB deployment shared with the bot; the panel refuses to start without it.
COMMENDBOT_MONGO_URI=mongodb+srv://USER:PASSWORD@your-cluster.example.mongodb.net/?retryWrites=true&w=majority

# Optional. Shared secret for the loopback control channel between panel and runners; a random one is generated when unset.
COMMENDBOT_IPC_TOKEN=

# Optional. Path to the JSON file listing the game servers; see servers.example.json for the format.
COMMENDBOT_SERVERS_FILE=servers.json
